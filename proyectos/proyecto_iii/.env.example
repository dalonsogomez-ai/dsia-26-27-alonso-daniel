# Exporta estas variables antes de arrancar Uvicorn, pásalas con `uvicorn --env-file` (copiando este fichero a
# un .env, que git ignora; las ya exportadas en la shell mandan) o configúralas en el PaaS.
DSIA_SNAPSHOT=runs/dsia-demo/snapshot.json
# JSONL del lote que leen /health y /api/v1/pipeline (opcional).
DSIA_JOURNAL=runs/dsia-evidence/pipeline.jsonl
# Si se define, POST /api/v1/analyze exige la cabecera X-API-Key con este valor. Vacía = sin clave.
DSIA_API_KEY=
# Límite de uso de POST /api/v1/analyze: análisis por minuto y por conexión, tope diario del servicio y cupo
# diario por conexión (ambos vuelven a 0 a las 00:00 UTC). Vacío = 5, 200 y 30.
# En todas las variables DSIA_ANALYZE_*, 0, negativos o no enteros detienen el arranque (no hay modo
# «sin límite»); DSIA_TRUSTED_PROXY_HOPS admite 0. El log da la longitud del valor no válido, nunca el valor.
DSIA_ANALYZE_PER_MINUTE=5
DSIA_ANALYZE_PER_DAY=200
DSIA_ANALYZE_PER_IP_DAY=30
# Análisis simultáneos; con el cupo lleno, 503 analyze_busy al momento con Retry-After: 10. Vacío = 4.
DSIA_ANALYZE_CONCURRENCY=4
# Análisis simultáneos por conexión; con 2 en curso, 429 analyze_busy_client al momento con Retry-After: 10. Vacío = 2.
DSIA_ANALYZE_CONCURRENCY_PER_IP=2
# Proxies de confianza delante del servicio: la IP del cliente es ese salto contando desde la derecha de
# X-Forwarded-For (todas sus líneas). En Render (RENDER=true, lo define Render) manda antes CF-Connecting-IP.
# 0 = sin proxy delante (docker run -p o uvicorn expuesto en local): se ignora X-Forwarded-For. Vacío = 1.
DSIA_TRUSTED_PROXY_HOPS=1
# Commit que muestran /health y /api/v1/metrics fuera de Render (en Render manda RENDER_GIT_COMMIT). Vacío = local.
# Solo un hash hexadecimal de 7 a 40 caracteres (git rev-parse HEAD); otro valor se publica como «invalid».
DSIA_COMMIT=
# Segundos máximos del refresco con Alpaca al arrancar el contenedor (serve.py); al vencer se sirve el informe de la imagen.
DSIA_REFRESH_TIMEOUT=180
# Cliente de IA del Proyecto II: mock por defecto; hf requiere HF_TOKEN y nvidia, NVIDIA_API_KEY (nunca se versionan).
AI_PROVIDER=mock
# Solo con AI_PROVIDER=mock: down, timeout, invalid o bug hacen fallar cada análisis (503, 504, 502 o 500)
# para enseñar cada rama sin red. Vacío = el mock responde normal; con hf o nvidia se ignora.
AI_MOCK_MODE=
HF_TOKEN=
HF_MODEL=Qwen/Qwen2.5-7B-Instruct
HF_TIMEOUT=30
HF_MAX_TOKENS=256
HF_INFERENCE_PROVIDER=auto
# Alternativa a HF en build.nvidia.com: timeout entre 1 y 120 s y tokens entre 1 y 4096.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NVIDIA_TIMEOUT=60
NVIDIA_MAX_TOKENS=4096

# Lote con datos reales (python -m dsia_web.build alpaca|auto). En Render son variables de entorno
# del panel (sync: false): serve.py las lee al arrancar y refresca el informe. El secret file
# `alpaca.env` es opcional: en el build se monta como build secret `alpaca_env` y, en ejecución,
# serve.py lo lee en /etc/secrets/alpaca.env si no hay variables. Nunca en Git ni en la imagen: alpaca.env
# y cualquier *.env están en .gitignore y .dockerignore.
ALPACA_PAPER_API_KEY_ID=
ALPACA_PAPER_API_SECRET_KEY=
# Opcionales: universo (por defecto los 10 del Proyecto I), inicio del histórico y feed (sip con reintento en iex).
DSIA_SYMBOLS=
DSIA_START=2018-01-01
DSIA_ALPACA_FEED=sip
