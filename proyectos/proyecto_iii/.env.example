# Exporta estas variables antes de arrancar Uvicorn, o configúralas en el PaaS.
DSIA_SNAPSHOT=runs/dsia-demo/snapshot.json
# JSONL del lote que leen /health y /api/v1/pipeline (opcional).
DSIA_JOURNAL=runs/dsia-evidence/pipeline.jsonl
# Si se define, POST /api/v1/analyze exige la cabecera X-API-Key con este valor. Vacía = sin clave.
DSIA_API_KEY=
# Cliente de IA del Proyecto II: mock por defecto; hf requiere HF_TOKEN (nunca se versiona).
AI_PROVIDER=mock
HF_TOKEN=
HF_MODEL=Qwen/Qwen2.5-7B-Instruct
HF_TIMEOUT=30
HF_MAX_TOKENS=256
HF_INFERENCE_PROVIDER=auto
