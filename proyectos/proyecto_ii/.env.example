# -> Configuración local de los Proyectos II y III. Copiar a .env (ignorado por Git) y no versionar claves.
# > AI_PROVIDER: mock (por defecto, sin red ni token), hf o nvidia; huggingface es alias de hf.
AI_PROVIDER=mock
# > HF_TOKEN: token personal de Hugging Face; solo se lee al llamar al proveedor real y nunca se registra.
HF_TOKEN=
# > HF_MODEL: modelo del Hub en formato owner/name (tarea chat_completion).
HF_MODEL=Qwen/Qwen2.5-7B-Instruct
# > HF_INFERENCE_PROVIDER: auto o un identificador en minúsculas con guiones, p. ej. featherless-ai.
HF_INFERENCE_PROVIDER=auto
# > HF_TIMEOUT: segundos por intento, entre 1 y 120. HF_MAX_TOKENS: tokens de salida, entre 1 y 512.
HF_TIMEOUT=30
HF_MAX_TOKENS=256
# > NVIDIA_API_KEY: clave de build.nvidia.com (alternativa a HF); solo se lee al llamar y nunca se registra.
NVIDIA_API_KEY=
# > NVIDIA_MODEL: modelo del catálogo en formato owner/name; p. ej. mistralai/mistral-large-4-1t-a52b.
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
# > NVIDIA_TIMEOUT: segundos por intento, entre 1 y 120. NVIDIA_MAX_TOKENS: entre 1 y 4096 (incluye el razonamiento).
NVIDIA_TIMEOUT=60
NVIDIA_MAX_TOKENS=4096
# > Alpaca paper (opcional, fuera del enunciado): solo paper-plan y paper-execute; nunca una cuenta live.
ALPACA_PAPER_API_KEY_ID=
ALPACA_PAPER_API_SECRET_KEY=
